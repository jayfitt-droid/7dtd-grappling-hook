<configs>
    <!-- Schematics turn up in the game's own schematic loot pools: iron in the
         mid-tier pool, steel in the late-tier pool. -->
    <append xpath="/lootcontainers/lootgroup[@name='schematicsModsAndGeneralT1']">
        <item name="ammoGrapplingHookIronSchematic"/>
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='schematicsModsAndGeneralT2']">
        <item name="ammoGrapplingHookSteelSchematic"/>
    </append>
</configs>
